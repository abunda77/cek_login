# Active provider configuration (copy to .env and replace the API key)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace_with_your_api_key

# -----------------------------------------------------------------------------
# Provider catalog: uncomment one provider block in .env when needed.
# Keep only one active LLM_BASE_URL, LLM_MODEL, and LLM_API_KEY set.
# Model names and availability depend on your account, region, and provider plan.
# -----------------------------------------------------------------------------

# OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=replace_with_openai_api_key

# Anthropic (native API; use an Anthropic-compatible client)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-sonnet-latest
# LLM_API_KEY=replace_with_anthropic_api_key

# Google Gemini API
# LLM_PROVIDER=google
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=replace_with_google_ai_api_key

# xAI Grok (OpenAI-compatible)
# LLM_PROVIDER=xai
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-3-mini
# LLM_API_KEY=replace_with_xai_api_key

# DeepSeek (OpenAI-compatible)
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=replace_with_deepseek_api_key

# Mistral AI (OpenAI-compatible)
# LLM_PROVIDER=mistral
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=replace_with_mistral_api_key

# Cohere
# LLM_PROVIDER=cohere
# LLM_BASE_URL=https://api.cohere.com/compatibility/v1
# LLM_MODEL=command-r-plus
# LLM_API_KEY=replace_with_cohere_api_key

# Groq (OpenAI-compatible)
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=replace_with_groq_api_key

# Together AI (OpenAI-compatible)
# LLM_PROVIDER=together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# LLM_API_KEY=replace_with_together_api_key

# Fireworks AI (OpenAI-compatible)
# LLM_PROVIDER=fireworks
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
# LLM_API_KEY=replace_with_fireworks_api_key

# Perplexity (OpenAI-compatible)
# LLM_PROVIDER=perplexity
# LLM_BASE_URL=https://api.perplexity.ai
# LLM_MODEL=sonar-pro
# LLM_API_KEY=replace_with_perplexity_api_key

# OpenRouter (multi-provider gateway, OpenAI-compatible)
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_API_KEY=replace_with_openrouter_api_key

# Cerebras (OpenAI-compatible)
# LLM_PROVIDER=cerebras
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_MODEL=llama-3.3-70b
# LLM_API_KEY=replace_with_cerebras_api_key

# SambaNova (OpenAI-compatible)
# LLM_PROVIDER=sambanova
# LLM_BASE_URL=https://api.sambanova.ai/v1
# LLM_MODEL=Meta-Llama-3.3-70B-Instruct
# LLM_API_KEY=replace_with_sambanova_api_key

# Azure OpenAI
# LLM_PROVIDER=azure-openai
# LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1
# LLM_MODEL=YOUR_AZURE_DEPLOYMENT_NAME
# LLM_API_KEY=replace_with_azure_openai_api_key

# AWS Bedrock (not a universal OpenAI-compatible base URL; configure an
# AWS/Bedrock-specific client and credentials instead)
# LLM_PROVIDER=bedrock
# LLM_BASE_URL=configure_with_your_bedrock_client
# LLM_MODEL=anthropic.claude-3-5-sonnet
# LLM_API_KEY=not_used_use_aws_credentials

# Local OpenAI-compatible server: Ollama
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# Local OpenAI-compatible server: LM Studio
# LLM_PROVIDER=lm-studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
# LLM_API_KEY=lm-studio
